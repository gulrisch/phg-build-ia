# ── PHG BUILD IA — Variables d'environnement backend ──────────────────────────
# Copier ce fichier en .env et remplir les valeurs réelles

# Base de données (Railway fournit automatiquement DATABASE_URL)
DATABASE_URL=sqlite:///./phg_build_ia.db
# Production PostgreSQL exemple :
# DATABASE_URL=postgresql://user:password@host:5432/phg_build_ia

# Sécurité JWT (générer avec : openssl rand -hex 32)
SECRET_KEY=CHANGEZ_MOI_AVEC_UNE_CLE_ALEATOIRE_LONGUE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Stripe — récupérer sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_VOTRE_CLE_SECRETE
STRIPE_PUBLISHABLE_KEY=pk_live_VOTRE_CLE_PUBLIQUE
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_SECRET_WEBHOOK

# Prix Stripe — créer sur https://dashboard.stripe.com/products
# PRO mensuel : 12.90€
STRIPE_PRICE_PRO=price_XXXXXXXXXXXXXXXXXX
# PRO annuel : 77€
STRIPE_PRICE_PRO_ANNUAL=price_XXXXXXXXXXXXXXXXXX
# Elite mensuel : 25€
STRIPE_PRICE_ELITE=price_XXXXXXXXXXXXXXXXXX
# Elite annuel : 210€
STRIPE_PRICE_ELITE_ANNUAL=price_XXXXXXXXXXXXXXXXXX
# Elite Afrique mensuel : 17€
STRIPE_PRICE_ELITE_AFRIQUE=price_XXXXXXXXXXXXXXXXXX
# Elite Afrique annuel : 135€
STRIPE_PRICE_ELITE_AFRIQUE_ANNUAL=price_XXXXXXXXXXXXXXXXXX

# URLs (Railway fournit automatiquement le domaine)
FRONTEND_URL=https://phg-build-ia.vercel.app
BACKEND_URL=https://phg-build-ia-backend.up.railway.app

# Anthropic (optionnel — pour l'assistant IA)
ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_ICI
