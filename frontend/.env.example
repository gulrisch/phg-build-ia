# ── PHG BUILD IA — Variables d'environnement frontend ─────────────────────────
# Copier ce fichier en .env (local) ou .env.production (Vercel)
# Sur Vercel : configurer dans Settings > Environment Variables

# URL du backend Railway (sans slash final)
VITE_API_URL=https://phg-build-ia-backend.up.railway.app

# Anthropic (optionnel — appels directs depuis le navigateur)
# ATTENTION : ne pas exposer de clé en production côté client
# Utiliser le backend comme proxy à la place
VITE_ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_ICI
